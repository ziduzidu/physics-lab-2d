<view class="page">
    <view class="brand">
        <view class="logo">物</view>
        <view class="brand-text">
            <view class="htitle">高考物理 <text class="hlite">仿真实验室</text></view>
            <view class="hsub">力学 · 能量动量 · 运动图像 · 天体</view>
        </view>
    </view>

    <view class="empty" wx:if="{{err}}">{{err}}</view>

    <view class="grid" wx:else>
        <view class="mcard" wx:for="{{modules}}" wx:key="id" data-id="{{item.id}}" bindtap="openModule">
            <view class="mhead">
                <text class="micon">{{item.icon}}</text>
                <text class="mname">{{item.name}}</text>
                <text class="mgo">进入 →</text>
            </view>
            <text class="mdesc">{{item.desc}}</text>
            <view class="mtags">
                <text class="mtag" wx:for="{{item.tags}}" wx:for-item="tg" wx:key="*this">{{tg}}</text>
            </view>
        </view>
    </view>

    <view class="foot">
        <text class="foot-line">共 {{modules.length}} 个模块 · {{totalExamples}} 道例题 · 不需要登录</text>
        <text class="foot-link" bindtap="openAbout">关于</text>
    </view>
</view>
