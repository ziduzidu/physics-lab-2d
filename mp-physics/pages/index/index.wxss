.page {
    min-height: 100vh;
    padding: 28rpx 20rpx 60rpx;
    background: #f4f6fa;
}

.brand {
    display: flex;
    align-items: center;
    padding: 8rpx 8rpx 28rpx;
}

.logo {
    width: 76rpx;
    height: 76rpx;
    margin-right: 20rpx;
    border-radius: 20rpx;
    background: #2563eb;
    color: #fff;
    font-size: 40rpx;
    font-weight: 700;
    line-height: 76rpx;
    text-align: center;
}

.brand-text {
    flex: 1;
    min-width: 0;
}

.htitle {
    font-size: 34rpx;
    font-weight: 700;
    color: #1f2937;
}

.hlite {
    color: #2563eb;
}

.hsub {
    margin-top: 6rpx;
    color: #6b7280;
    font-size: 23rpx;
}

.grid {
    display: flex;
    flex-direction: column;
}

.mcard {
    margin-bottom: 16rpx;
    padding: 22rpx 22rpx 18rpx;
    border: 1rpx solid #e2e8f0;
    border-radius: 18rpx;
    background: #fff;
}

.mcard:active {
    background: #f8fafc;
}

.mhead {
    display: flex;
    align-items: center;
}

.micon {
    width: 52rpx;
    height: 52rpx;
    margin-right: 16rpx;
    border-radius: 14rpx;
    background: #eff6ff;
    color: #2563eb;
    font-size: 28rpx;
    line-height: 52rpx;
    text-align: center;
}

.mname {
    flex: 1;
    min-width: 0;
    font-size: 30rpx;
    font-weight: 600;
    color: #1f2937;
}

.mgo {
    color: #2563eb;
    font-size: 23rpx;
    white-space: nowrap;
}

.mdesc {
    display: block;
    margin-top: 14rpx;
    color: #6b7280;
    font-size: 24rpx;
    line-height: 1.62;
}

.mtags {
    display: flex;
    flex-wrap: wrap;
    margin-top: 14rpx;
}

.mtag {
    margin: 0 10rpx 8rpx 0;
    padding: 4rpx 14rpx;
    border-radius: 10rpx;
    background: #f1f5f9;
    color: #475569;
    font-size: 21rpx;
}

.foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20rpx 12rpx 0;
}

.foot-line {
    color: #9ca3af;
    font-size: 22rpx;
}

.foot-link {
    color: #2563eb;
    font-size: 23rpx;
}
